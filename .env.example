# ============================================================
# MediCare – Full Stack Environment Variables Template
# Copy this file to .env and configure for local development or production.
# ============================================================

# ============================================================
# BACKEND CONFIGURATION (Render / Cloud Environment)
# ============================================================
PORT=8080

# MySQL Database
# You can set DB_URL directly, or DB_HOST + DB_PORT + DB_NAME
# DB_URL=jdbc:mysql://your-cloud-host.com:3306/medicare?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medicare
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JWT Security
JWT_SECRET=medicare_production_secret_key_must_be_at_least_256_bits_long_healthcare_system_secure_2026
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Add your Vercel URL here)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173,https://*.vercel.app

# Hibernate & Data Seeding
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false
SEED_DEMO_DATA=true

# ============================================================
# FRONTEND CONFIGURATION (Vercel Environment)
# ============================================================
# Set this in Vercel project environment variables to point to your Render backend:
VITE_API_BASE_URL=http://localhost:8080
