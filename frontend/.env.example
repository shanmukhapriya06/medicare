# ============================================================
# MediCare Frontend – Environment Variables Template
# Copy this file to .env or .env.local for local development.
# For Vercel deployment: Configure this in Vercel Project Settings -> Environment Variables.
# Note: In Vite, all client-exposed variables MUST start with VITE_
# ============================================================

# Backend API Base URL
# Local Development: http://localhost:8080
# Production (Render): https://your-medicare-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8080
