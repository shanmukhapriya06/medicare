# ============================================================
# MediCare Backend – Environment Variables Template
# Copy this file to .env and customize with your credentials.
# On Render: Enter these key-value pairs in the "Environment Variables" tab.
# ============================================================

# ------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------
# Port the Spring Boot application listens on.
# Render automatically injects the PORT environment variable in production.
PORT=8080

# ------------------------------------------------------------
# 2. Database Configuration (MySQL)
# ------------------------------------------------------------
# OPTION A: Full JDBC URL (Recommended for Cloud Providers like Aiven, Clever Cloud, Railway, PlanetScale, TiDB Cloud)
# DB_URL=jdbc:mysql://your-cloud-host.com:3306/medicare?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC

# OPTION B: Host, Port, and Database Name (Used if DB_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medicare

# Database Credentials
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# ------------------------------------------------------------
# 3. Security & JWT Token Configuration
# ------------------------------------------------------------
# Must be at least 256 bits (32 characters or longer). Generate a strong random key for production.
JWT_SECRET=medicare_production_secret_key_must_be_at_least_256_bits_long_healthcare_system_secure_2026

# Token expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------
# 4. CORS Allowed Origins (Cross-Origin Resource Sharing)
# ------------------------------------------------------------
# Comma-separated list of allowed frontend origins or wildcard patterns.
# Include your Vercel deployment URL (e.g. https://your-project.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173,https://*.vercel.app

# ------------------------------------------------------------
# 5. Application & Hibernate Settings
# ------------------------------------------------------------
# Hibernate schema management: 'update' automatically creates/updates tables on startup.
HIBERNATE_DDL_AUTO=update

# Disable SQL logging in production for cleaner logs and better performance
SHOW_SQL=false

# Automatically seeds administrator (admin@medicare.com / Admin@123) and sample doctors on first boot
SEED_DEMO_DATA=true
